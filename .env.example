# 复制本文件为 .env.local 并填入真实值

# 阿里云百炼 API 密钥（必需）
DASHSCOPE_API_KEY=sk-你的API密钥

# API 基础地址（OpenAI 兼容模式）
# 支持：阿里云百炼、DeepSeek、Kimi、OpenAI、豆包等
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型
# 支持：qwen3.7-plus, qwen3.7-max, kimi-k2.7-code, deepseek-chat, gpt-4o 等
AI_DEFAULT_MODEL=qwen3.7-plus

# 可选：OpenAI 兼容 API 基础地址
# OPENAI_API_KEY=sk-你的OpenAI密钥
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：DeepSeek API 配置
# DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：Kimi API 配置
# KIMI_API_KEY=sk-你的Kimi密钥
# KIMI_BASE_URL=https://api.moonshot.cn/v1
